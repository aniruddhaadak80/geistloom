{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && bun install --frozen-lockfile",
      "buildCommand": "cd ../.. && bunx turbo run build --filter=@geistloom/web --force",
      "outputDirectory": ".next"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }],
  "github": {
    "autoDeploy": true,
    "silent": true
  },
  "env": {
    "NEXT_PUBLIC_SIM_SEED": "4093"
  }
}
