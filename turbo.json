{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["GEISTLOOM_STANDALONE", "NEXT_PUBLIC_APP_URL", "NEXT_PUBLIC_SIM_SEED"],
  "globalPassThroughEnv": [
    "GEISTLOOM_STANDALONE",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SIM_SEED",
    "PORT",
    "E2E_PORT"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*", "app/**/*", "lib/**/*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "loc": {
      "cache": false
    }
  }
}
