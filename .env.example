# Geistloom — environment template.
# No secrets are ever committed. Real values are injected via {env:...} or {file:...} substitution.

# --- Web app (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SIM_SEED=4093

# --- Oracle Python service (services/oracle) ---
ORACLE_SERVICE_URL=http://localhost:8787
ORACLE_DETERMINISTIC=1
ORACLE_SEED=4093

# --- Go telemetry relay (services/relay) ---
RELAY_ADDR=:9119
RELAY_OTEL_ENDPOINT=http://localhost:4318

# --- Deploy targets (documented; never store values here) ---
# VERCEL_TOKEN={env:VERCEL_TOKEN}
# VERCEL_ORG_ID={env:VERCEL_ORG_ID}
# VERCEL_PROJECT_ID={env:VERCEL_PROJECT_ID}
# FLY_API_TOKEN={env:FLY_API_TOKEN}
# RENDER_API_KEY={env:RENDER_API_KEY}
