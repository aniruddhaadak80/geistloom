{
  "name": "geistloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The world-frame where superintelligence solves aging — and everything else.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "test": "turbo run test",
    "loc": "bun scripts/loc-count.mjs",
    "generate": "bun scripts/generate.ts",
    "seed": "bun packages/seed/seed.ts",
    "ci": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.15.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.2.0"
  }
}
